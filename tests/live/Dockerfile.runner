# Test runner image for the live suite: Python + the Microsoft ODBC Driver 18.
#
# The project's host venv cannot import pyodbc on Linux without unixODBC and the
# Microsoft driver, and installing those needs root. Running the suite inside this image
# keeps the host untouched: the repo is bind-mounted, and the virtualenv lives in /tmp so
# the host's .venv is never overwritten by a differently-linked interpreter.
#
#   docker build -t stsk-odbc-runner -f tests/live/Dockerfile.runner tests/live
#   docker run --rm --network live_default -v "$PWD":/src -w /src \
#       -e SWISSKNIFE_TEST_DB_URL="mssql://sa:SwissKnife%212022_Test@sqlserver:1433/SwissKnifeSample" \
#       stsk-odbc-runner uv run pytest -m live -v

FROM python:3.14-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    ACCEPT_EULA=Y \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_PROJECT_ENVIRONMENT=/tmp/stsk-venv \
    UV_PYTHON_DOWNLOADS=never

# unixODBC + MS ODBC Driver 18 from Microsoft's Debian repo. Bookworm matches the base
# image's Debian release, which is what the msodbcsql18 package is built against.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg apt-transport-https unixodbc; \
    curl -fsSL https://packages.microsoft.com/keys/microsoft.asc \
        | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg; \
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/microsoft-prod.gpg] \
https://packages.microsoft.com/debian/12/prod bookworm main" \
        > /etc/apt/sources.list.d/mssql-release.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends msodbcsql18; \
    rm -rf /var/lib/apt/lists/*

# The package ships its own odbcinst.ini under /opt/microsoft/msodbcsql18/etc, pointing at
# the exact libmsodbcsql-<version>.so that was installed. Symlink that instead of writing our
# own entry: a hand-written Driver= line goes stale on every driver upgrade (pinning 18.4
# while 18.7 is installed fails with a misleading "file not found" from the driver manager).
RUN ln -sf /opt/microsoft/msodbcsql18/etc/odbcinst.ini /etc/odbcinst.ini

COPY --from=ghcr.io/astral-sh/uv:0.12.5 /uv /uvx /usr/local/bin/

# Build tools are needed only if a wheel is missing for cp314; kept out of the final layer
# by installing into the venv first and purging afterwards.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Fail the build if the driver stack is not actually usable, rather than at test time.
RUN printf 'import pyodbc\nprint(pyodbc.drivers())\nassert any("SQL Server" in d for d in pyodbc.drivers()), pyodbc.drivers()\n' \
        > /tmp/check.py \
    && (uv venv --python 3.14 /tmp/stsk-venv \
        && /tmp/stsk-venv/bin/python -m pip install --quiet pyodbc \
        && /tmp/stsk-venv/bin/python /tmp/check.py \
        && uv pip uninstall --python /tmp/stsk-venv pyodbc || true) \
    && apt-get purge -y build-essential && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

CMD ["uv", "run", "pytest", "-m", "live", "-v"]
